{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MiOCRPotente: descargar idiomas",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\Install-Tessdata.ps1"],
      "problemMatcher": []
    },
    {
      "label": "MiOCRPotente: compilar",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}\\MiOcrPotente.sln", "-c", "Debug"],
      "problemMatcher": "$msCompile",
      "dependsOn": "MiOCRPotente: descargar idiomas"
    },
    {
      "label": "MiOCRPotente: publicar Windows x64",
      "type": "process",
      "command": "dotnet",
      "args": ["publish", "${workspaceFolder}\\MiOcrPotente.csproj", "-c", "Release", "-r", "win-x64", "--self-contained", "false"],
      "problemMatcher": "$msCompile",
      "dependsOn": "MiOCRPotente: descargar idiomas"
    }
  ]
}
